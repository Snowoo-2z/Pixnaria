# Pixnaria environment variables
# Copy this file to `.env` for local development (never commit `.env`).
# On Vercel, set these in Project Settings → Environment Variables.

# --- Visitor GitHub OAuth app (lets any visitor sign in with GitHub) ---
# Create at https://github.com/settings/developers > "New OAuth App".
# Homepage URL: your Pixnaria URL (e.g. https://pixnaria.vercel.app)
# Authorization callback URL: <your-url>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only needed if it can't be inferred from the request (custom domains, etc.)
# GITHUB_CALLBACK_URL=https://pixnaria.vercel.app/api/auth/github/callback
# PUBLIC_BASE_URL=https://pixnaria.vercel.app

# Secret used to sign session cookies. Any long random string.
SESSION_SECRET=

# --- Pixnaria data store (replaces Supabase) ---
# All profiles/projects/likes/comments/reports/bans/news/studios/messages are
# stored as JSON files directly inside this GitHub repository, on a
# dedicated branch (created automatically) so they never touch `main`.
#
# DATA_GITHUB_TOKEN must be a Personal Access Token belonging to a repo
# maintainer (fine-grained PAT scoped to this repo with
# "Contents: Read and write", or a classic PAT with the `repo` scope).
# This token is only used by the server — visitors never need it.
DATA_GITHUB_TOKEN=
# DATA_REPO_OWNER=Snowoo-2z
# DATA_REPO_NAME=Pixnaria
# DATA_REPO_BRANCH=pixnaria-data
